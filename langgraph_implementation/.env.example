# Example .env file for Elysia LangGraph Configuration
# Copy this to .env and fill in your actual values

# ============================================
# LLM Configuration
# ============================================

# OpenAI API Key
OPENAI_API_KEY=sk-your-key-here

# Model selection
OPENAI_MODEL=gpt-4-turbo-preview
# Options: gpt-4, gpt-4-turbo-preview, gpt-3.5-turbo, etc.

# Alternative: Anthropic (Claude)
# ANTHROPIC_API_KEY=your-anthropic-key

# ============================================
# Weaviate Configuration
# ============================================

# Weaviate Cloud cluster URL
WCD_URL=https://your-cluster-id.weaviate.cloud

# Weaviate API Key
WCD_API_KEY=your-weaviate-api-key

# Or for local instance:
# WCD_URL=http://localhost:8080
# WCD_API_KEY=

# ============================================
# LangGraph Configuration
# ============================================

# Tree execution mode: multibranch or onebranch
LANGGRAPH_MODE=multibranch

# Maximum depth for tree traversal (prevents infinite loops)
MAX_TREE_DEPTH=5

# Recursion limit for LangGraph execution
RECURSION_LIMIT=100

# ============================================
# Features
# ============================================

# Enable Weaviate integration
USE_WEAVIATE=true

# Enable LLM-based decision making
USE_LLM=true

# Enable async operations
ENABLE_ASYNC=true

# ============================================
# Debugging & Logging
# ============================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable debug mode
DEBUG=false

# ============================================
# Optional: LLamaIndex / Vector Store Integration
# ============================================

# If using alternative embedding providers
# EMBEDDING_MODEL=text-embedding-ada-002
# EMBEDDING_PROVIDER=openai
